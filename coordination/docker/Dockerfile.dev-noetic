# Development verification image only; it is not an organizer-provided
# competition image and must never be used to infer competition interfaces.
FROM ros:noetic-ros-base-focal@sha256:72b8bc59035dc0a5b8e07aae28c16caa84192971d72d207c72ed734fb1d5e97d

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        build-essential \
        python3-catkin-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash"]
