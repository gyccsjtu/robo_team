<?xml version="1.0"?>
<package format="2">
  <name>robocup_navigation</name>
  <version>0.1.0</version>
  <description>Single-UAV motion, static A* route execution and conservative safety checks for RoboCup simulation.</description>

  <maintainer email="maintainer@example.invalid">RoboCup Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
  </export>
</package>
