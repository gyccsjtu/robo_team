+class GroundBeamFilterTests(unittest.TestCase):
+    """机体倾斜时的地面回波净化；合成扫描，无 ROS。"""
+
+    N = 512
+    INC = 2 * math.pi / N
+
+    @staticmethod
+    def zrow(pitch_deg):
+        t = math.radians(pitch_deg)
+        return (-math.sin(t), 0.0)          # 纯俯仰：R20=-sin(theta), R21=0
+
+    def synth(self, z_sensor, pitch_deg, wall=None, wall_half_deg=3.):
+        r20, r21 = self.zrow(pitch_deg)
+        rng = []
+        for i in range(self.N):
+            a = -math.pi + i * self.INC
+            dz = r20 * math.cos(a) + r21 * math.sin(a)
+            r = math.inf
+            if dz < 0:
+                rg = -z_sensor / dz
+                if rg <= 20.:
+                    r = rg
+            if wall is not None and abs(a) <= math.radians(wall_half_deg):
+                r = wall
+            rng.append(r)
+        return rng, (r20, r21)
+
+    def call(self, ranges, vx, **changed):
+        kw = dict(request=(vx, 0.), measured=(vx, 0.), yaw=0., ranges=ranges,
+                  angle_min=-math.pi, angle_increment=self.INC,
+                  range_min=.5, range_max=20., scan_s=10., now_s=10.1)
+        kw.update(changed)
+        return guard_velocity(**kw)
+
+    def filt(self, ranges, zrow, z_sensor):
+        return filter_ground_beams(ranges, -math.pi, self.INC,
+                                   zrow[0], zrow[1], z_sensor)
+
+    def test_level_flight_is_untouched(self):
+        z = 2.8 + MOUNT_Z
+        raw, zrow = self.synth(z, 0.)
+        out, n = self.filt(raw, zrow, z)
+        self.assertEqual(n, 0)
+        self.assertEqual(out, raw)
+        self.assertEqual(self.call(raw, 3.5)['velocity_xy'],
+                         self.call(out, 3.5)['velocity_xy'])
+
+    def test_tilted_open_space_stops_false_positive(self):
+        z = 2.8 + MOUNT_Z
+        raw, zrow = self.synth(z, 12.)
+        self.assertTrue(any(math.isfinite(r) for r in raw))
+        self.assertEqual(self.call(raw, 3.5)['reason'], 'BRAKING_REQUIRED')
+        out, n = self.filt(raw, zrow, z)
+        self.assertGreater(n, 0)
+        self.assertEqual(self.call(out, 3.5)['reason'], 'CLEAR')
+
+    def test_real_wall_nearer_than_ground_intercept_is_preserved(self):
+        z = 2.8 + MOUNT_Z
+        raw, zrow = self.synth(z, 12., wall=8.)
+        before = self.call(raw, 3.5)
+        out, _ = self.filt(raw, zrow, z)
+        after = self.call(out, 3.5)
+        self.assertEqual(before['reason'], after['reason'])
+        self.assertEqual(before['velocity_xy'], after['velocity_xy'])
+        self.assertTrue(any(abs(r - 8.) < 1e-9 for r in out))
+
+    def test_removal_shrinks_with_altitude_and_vanishes_on_top_layer(self):
+        counts = []
+        for alt in (2.8, 3.4, 4.0, 4.6):
+            z = alt + MOUNT_Z
+            raw, zrow = self.synth(z, 12.)
+            counts.append(self.filt(raw, zrow, z)[1])
+        self.assertEqual(counts[-1], 0)                     # 4.6m 层：完全不动作
+        self.assertEqual(counts, sorted(counts, reverse=True))   # 越高层剔得越少
+
+    def test_disabled_without_altitude_or_attitude(self):
+        z = 2.8 + MOUNT_Z
+        raw, _ = self.synth(z, 12.)
+        for r20, r21, zs in ((*self.zrow(12.), .4), (0., 0., z)):
+            out, n = filter_ground_beams(raw, -math.pi, self.INC, r20, r21, zs)
+            self.assertEqual(n, 0)
+            self.assertEqual(out, raw)
+
+    def test_ground_band_matches_predicted_horizon(self):
+        z = 2.8 + MOUNT_Z
+        raw, zrow = self.synth(z, 12.)
+        n = self.filt(raw, zrow, z)[1]
+        half = math.degrees(math.acos(z / (20. * math.sin(math.radians(12.)))))
+        expected = 2 * half / math.degrees(self.INC)
+        self.assertAlmostEqual(n, expected, delta=4)
+
