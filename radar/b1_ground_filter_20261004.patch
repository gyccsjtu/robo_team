+# ---------------------------------------------------------------------------
+# 地面回波剔除（机体倾斜时的必要净化）
+#
+# 2D 雷达随机体刚性转动：机体一俯仰/横滚（爬升、制动、ORCA 急转都会有），
+# 扫描面跟着倾斜，就有光束打到地面。这些地面回波若混进 corridor_clearance()，
+# 会被当成"前方有障碍"。
+#   实测（层高 2.8m、俯仰 12°、3.5 m/s、开阔无墙）：过滤前 BRAKING_REQUIRED
+#   （输出 (0,0) 急停），过滤后 CLEAR —— 纯假阳性。
+#
+# 判据纯几何：机体系角度 a 的射线经机体->世界旋转矩阵 R 后，世界系 z 分量
+#     d_z = R20*cos(a) + R21*sin(a)        (R20, R21) = R 的第三行
+# d_z < 0 的束朝下，与地面交点斜距 r_gnd = -z_sensor / d_z；读数落在容差内
+# ⇒ 几何上必然打的是地面 ⇒ 置 inf（语义 = 该方向通，与无回波一致）。
+#
+# 安全性（已由合成扫描 + 契约测试验证）：
+#   * 水平飞行 d_z >= GROUND_MIN_DZ ⇒ 一束都不剔 ⇒ 与既有行为逐位一致；
+#   * 只删"预测地面截距"附近的读数，容差换算成高度窗口仅约 0.3~0.4m
+#     ⇒ 墙/人这类真障碍在更近处即被截住，不受影响；
+#   * z_sensor <= 0.5 或姿态未知（R20=R21=0）时自动完全失效。
+#
+# ⚠️ 残留（非本函数能解决）：强倾斜时正前方光束物理上先触地，
+#    有效前向地平线收缩到 z_sensor/tan(tilt)，更远的地物该姿态下本就打不到。
+#    该盲锥由**既有**的多帧占据图（ObservedMap → _online_safe_grid）补齐：
+#    radar_guard 是瞬时防线，栅格守卫（_grid_guard_velocity /
+#    online_planner.command_clear）持有历史帧证据，二者互补。
+#    B1/B1b 的作用是保证这条链**不被地面回波污染**（瞬时 + 地图喂入两处都过滤）。
+# ---------------------------------------------------------------------------
+MOUNT_Z = 0.080            # 雷达相对机体的安装高度（SDF 雷达 <pose> z）
+GROUND_TOL_ABS = 0.6       # 地面截距判定绝对容差 m
+GROUND_TOL_REL = 0.06      # 相对容差（随截距距离放大，远处放宽）
+GROUND_MIN_DZ = -0.05      # d_z 负过此值才算"朝下方"（约 2.9°）
+
+
+def filter_ground_beams(ranges, angle_min, angle_increment,
+                        r20, r21, z_sensor,
+                        tol_abs=GROUND_TOL_ABS, tol_rel=GROUND_TOL_REL):
+    """剔除几何上必然打到地面的雷达束。返回 (新 ranges 列表, 剔除束数)。
+
+    纯几何、无 ROS 依赖、不修改入参（返回新列表）。
+    水平/上仰束、NaN、inf 一律原样保留（NaN 仍按"堵"语义交给调用方）；
+    z_sensor <= 0.5（起飞前 / 位姿未就绪）时不启用；
+    R20 = R21 = 0（姿态未知）时 dz 恒为 0 ⇒ 同样不动作。
+    """
+    out = list(ranges)
+    n_gnd = 0
+    if z_sensor <= 0.5:
+        return out, 0
+    for i in range(len(out)):
+        r = float(out[i])
+        if not math.isfinite(r):
+            continue
+        a = angle_min + i * angle_increment
+        dz = r20 * math.cos(a) + r21 * math.sin(a)
+        if dz >= GROUND_MIN_DZ:
+            continue
+        r_gnd = -z_sensor / dz
+        if abs(r - r_gnd) <= tol_abs + tol_rel * r_gnd:
+            out[i] = float('inf')
+            n_gnd += 1
+    return out, n_gnd
