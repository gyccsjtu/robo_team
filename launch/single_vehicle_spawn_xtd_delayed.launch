<?xml version="1.0"?>
<!-- ============================================================================
  与官方 $(find px4)/launch/single_vehicle_spawn_xtd.launch **逐字等价**，
  只加一处：spawn_model 节点用 launch-prefix 延迟启动。

  为什么必须延迟（2026-10-03 实测根因）
  ────────────────────────────────────
  gazebo_ros_api_plugin.cpp:2744 写死 SDF spawn 超时 = 10.0 秒：
      ros::Duration model_spawn_timeout(10.0);
      res.status_message = "SpawnModel: Entity pushed to spawn queue,
                            but spawn service timed out ...";
  robocup.world（6 actor + 障碍 + 大量 mesh）首次加载要十几秒，此时发起
  spawn 必然超过 10s ⇒ 报 "Spawn service failed / timed out" ⇒ PX4 与模型
  之间**没有建立桥** ⇒ EKF 收不到传感器 ⇒ /mavros/local_position/pose 在
  ±150m 之间乱跳（实测）⇒ 飞机既飞不起来、也控不住（guided:False）。

  延迟到世界加载完再 spawn，10s 超时就不会触发。
  官方原始文件不动；本文件仅存在于我们自己的仓里。
============================================================================ -->
<launch>
    <!-- vehicle pose -->
    <arg name="x" default="0"/>
    <arg name="y" default="0"/>
    <arg name="z" default="0"/>
    <arg name="R" default="0"/>
    <arg name="P" default="0"/>
    <arg name="Y" default="0"/>
    <!-- vehcile model and config -->
    <arg name="est" default="ekf2"/>
    <arg name="vehicle" default="plane"/>
    <arg name="sdf" default="plane"/>
    <arg name="ID" default="0"/>
    <arg name="ID_in_group" default="0"/>
    <env name="PX4_SIM_MODEL" value="$(arg vehicle)" />
    <env name="PX4_ESTIMATOR" value="$(arg est)" />
    <arg name="mavlink_udp_port" default="14560"/>
    <arg name="mavlink_tcp_port" default="4560"/>
    <arg name="udp_gimbal_port" default="13030"/>
    <param name="robotNamespace" value="$(arg vehicle)_$(arg ID)"/>
    <!-- PX4 configs -->
    <arg name="interactive" default="true"/>
    <!-- 串行化延迟（秒）：等 Gazebo 把世界加载完再 spawn -->
    <arg name="spawn_delay" default="20"/>
    <!-- generate sdf vehicle model -->
    <arg name="cmd" default="xmlstarlet ed -d '//plugin[@name=&quot;gimbal_controller&quot;]/udp_gimbal_port_remote' -s '//plugin[@name=&quot;gimbal_controller&quot;]' -t elem -n udp_gimbal_port_remote -v $(arg udp_gimbal_port) -d '//plugin[@name=&quot;mavlink_interface&quot;]/mavlink_tcp_port' -s '//plugin[@name=&quot;mavlink_interface&quot;]' -t elem -n mavlink_tcp_port -v $(arg mavlink_tcp_port)
    $(find px4)/Tools/sitl_gazebo/models/$(arg sdf)/$(arg sdf).sdf"/>
    <param command="$(arg cmd)" name="model_description"/>
    <!-- PX4 SITL -->
    <arg unless="$(arg interactive)" name="px4_command_arg1" value=""/>
    <arg     if="$(arg interactive)" name="px4_command_arg1" value="-d"/>
    <node name="sitl_$(arg ID)" pkg="px4" type="px4" output="screen" args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i $(arg ID) -w sitl_$(arg vehicle)_$(arg ID) $(arg px4_command_arg1)">
    </node>
    <!-- spawn vehicle（延迟启动，绕过 10s 硬超时） -->
    <node name="$(arg vehicle)_$(arg ID)_spawn" output="screen" pkg="gazebo_ros" type="spawn_model"
          launch-prefix="$(env HOME)/robo_team/launch/delayed_exec.sh $(arg spawn_delay)"
          args="-sdf -param model_description -model $(arg vehicle)_$(arg ID_in_group) -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg R) -P $(arg P) -Y $(arg Y)"/>
</launch>
